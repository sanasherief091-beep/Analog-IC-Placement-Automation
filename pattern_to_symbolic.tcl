# =========================================================
# Project: Automatic Analog IC Layout Placement Script
# =========================================================

# Description:
# This TCL script automates the placement phase inside a
# physical design environment (Cadence-style toolflow).

# It performs the following tasks:
# - Reads a placement pattern generated from Python script
# - Applies device placement in the layout environment
# - Configures peripheral dummy devices
# - Performs source/drain splitting
# - Applies spacing configuration
# - Sets symbolic design options
# - Optionally prepares design for final realization

# Input:
# placement_pattern.txt (generated by Python tool)

# Output:
# Updated layout with applied placement and configuration


# =========================================================
# 1. Open design in active editable context
# =========================================================
set ctx [de::getActiveContext]
set design [db::getAttr editDesign -of $ctx]
puts "Design opened: $design"


# =========================================================
# 2. Get active design context
# =========================================================
set de_context [de::getActiveContext]
puts "Active design context obtained: $de_context"

# Open symbolic editor for placement view
ilx::symbolicEditor $de_context -source schematic -mode matching


# =========================================================
# 3. Read placement pattern file
# =========================================================
set patternFile "placement_pattern.txt"

if {![file exists $patternFile]} {
    puts "Error: Pattern file not found: $patternFile"
    return
}

set fp [open $patternFile r]
set file_data [read $fp]
close $fp

set full_pattern {}
set column_num 0
set repeatY 1

foreach line [split $file_data "\n"] {

    if {[string match "pattern=*" $line]} {
        set pattern_str [string range $line 8 end]
        set full_pattern [split $pattern_str " "]
    }

    if {[string match "columns=*" $line]} {
        set column_num [string range $line 8 end]
    }

    if {[string match "repeatY=*" $line]} {
        set repeatY [string range $line 8 end]
    }
}

puts "Pattern loaded   : $full_pattern"
puts "Columns          : $column_num"
puts "Repeat Y         : $repeatY"


# =========================================================
# 4. Apply placement pattern to layout
# =========================================================
lx::setPlacement \
    -pattern $full_pattern \
    -column $column_num \
    -repeatY $repeatY

puts "Placement applied successfully."


# =========================================================
# 5. Add peripheral dummy devices
# =========================================================
ilx::addPeripheralDummy

set curWin [gi::getActiveWindow]
set cmdToolbars [gi::getToolbars {deCommandOptions} -from $curWin]

if {[llength $cmdToolbars] > 0} {

    set cmdTB [lindex $cmdToolbars 0]

    gi::setField {dummyLeftRadioButton}   -value {true} -in $cmdTB
    gi::setField {bottomNumberInputValue} -value {0}    -in $cmdTB
    gi::setField {topNumberInputValue}    -value {0}    -in $cmdTB
    gi::setField {rightNumberInputValue}  -value {1}    -in $cmdTB
    gi::setField {leftNumberInputValue}   -value {1}    -in $cmdTB

    gi::pressButton {applyButton} -in $cmdTB

    puts "Peripheral dummy devices added."

} else {
    puts "Warning: deCommandOptions toolbar not found."
}


# =========================================================
# 6. Source / Drain splitting
# =========================================================
ilx::split
puts "Source and drain splitting applied."


# =========================================================
# 7. Select all placed devices
# =========================================================
set activeLXWindow [gi::getActiveWindow]
gi::executeAction {lxSelectAll} -in $activeLXWindow
puts "All devices selected."


# =========================================================
# 8. Apply spacing configuration
# =========================================================
set spacingTBs [gi::getToolbars {lxSpacingToolbar} -from $activeLXWindow]

if {[llength $spacingTBs] > 0} {

    set tb [lindex $spacingTBs 0]

    gi::setField {interRowLPP}      -value {PrBoundary\ drw} -in $tb
    gi::setField {intraRowSpacing}  -value {-0.222}          -in $tb
    gi::setField {interRowNumFins}  -value {0}               -in $tb

    puts "Spacing configuration applied."

} else {
    puts "Warning: spacing toolbar not found. Skipping spacing step."
}


# =========================================================
# 9. Configure symbolic design options
# =========================================================
lx::showSymbolicDesignOptions -parent $activeLXWindow
after 10

set dlgList [gi::getDialogs {lxSymbolicDesignOptions} -parent $activeLXWindow]

if {[llength $dlgList] > 0} {

    set dlg [lindex $dlgList 0]
    gi::setActiveDialog $dlg

    gi::setField {abutAfterEdit}        -value {false}  -in $dlg
    gi::setField {optimizePatternOD}    -value {false}  -in $dlg
    gi::setField {abutBulkAware}        -value {false}  -in $dlg
    gi::setField {abutSDAware}          -value {false}  -in $dlg
    gi::setField {showPreviewAssistant} -value {false}  -in $dlg
    gi::setField {fitTotalCount}        -value {true}   -in $dlg

    gi::setField {specifyBoundaryLPP}   -value {true}   -in $dlg
    gi::setField {sameRowspacingType}   -value {Microns} -in $dlg

    gi::pressButton {ok} -in $dlg

    puts "Symbolic design options configured."

} else {
    puts "Warning: symbolic design dialog not found."
}


# =========================================================
# 10. Final status
# =========================================================
puts "Placement flow completed successfully."


# =========================================================
# 11. Optional design realization
# =========================================================
# lx::realize
puts "Design realization step is optional (currently disabled)."