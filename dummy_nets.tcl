# =========================================================
# Script: Dummy Devices Tie-Off (Drain & Gate → Source Net)
# =========================================================

# Description:
# This script processes dummy devices generated from the
# symbolic placement flow (lxDummy instances).

# Key idea:
# - Dummy devices are automatically generated by the symbolic layout tool.
# - Each dummy device has a default naming convention (lxDummy*).
# - These devices are intentionally left partially unconnected.
# - In this flow, only the Source terminal is connected from the symbolic design.
# - Drain (D) and Gate (G) terminals are floating initially and must be tied.

# Purpose of this script:
# - Automatically connect Drain and Gate terminals of dummy devices
#   to the same net connected to the Source terminal.
# - Ensure electrical correctness for dummy boundary devices.
# - Clean up unconnected nets and enforce proper tie-off strategy.

# =========================================================

puts "--- STARTING DATABASE DUMMY TIE-OFF (D & G → SOURCE) ---"

# ---------------------------------------------------------
# 1. Get current active design
# ---------------------------------------------------------
set design [ed]

# ---------------------------------------------------------
# 2. Iterate over all instances in the design
# ---------------------------------------------------------
db::foreach inst [db::getInsts -of $design] {

    set instName [db::getAttr name -of $inst]

    # Process only dummy devices (default naming from symbolic flow)
    if {![string match "lxDummy*" $instName]} {
        continue
    }

    # -----------------------------------------------------
    # 3. Get Source terminal connection
    # -----------------------------------------------------
    set sTerms [db::getInstTerms S -of $inst]

    if {[db::getCount $sTerms] == 0} {
        puts "SKIP: $instName has no Source terminal"
        continue
    }

    set sTerm  [db::getIndex 0 -of $sTerms]
    set netObj [db::getAttr net -of $sTerm]

    if {$netObj == ""} {
        puts "SKIP: $instName Source is not connected"
        continue
    }

    set netName [db::getAttr name -of $netObj]
    puts "Processing $instName → tying D & G to Source net: $netName"

    # -----------------------------------------------------
    # 4. Tie Drain and Gate to Source net
    # -----------------------------------------------------
    foreach termName {D G} {

        # Remove any existing connections
        set oldTerms [db::getInstTerms $termName -of $inst]
        db::foreach t $oldTerms {
            db::destroy $t
        }

        # Create new connection to Source net
        db::createInstTerm $termName -inst $inst -net $netObj
    }
}

# ---------------------------------------------------------
# Completion message
# ---------------------------------------------------------
puts "--- DONE: Dummy tie-off completed successfully ---"